{
  "schemaVersion": 1,
  "id": "autooptimize",
  "version": "${version}",
  "name": "AutoOptimize SUPER",
  "description": "Optimizacion extrema y automatica: sin particulas nativas, mobs, animaciones y texturas recortados. Sin configuracion.",
  "environment": "*",
  "entrypoints": { "client": ["com.autooptimize.AutoOptimizeClient"] },
  "mixins": ["autooptimize.mixins.json", "autooptimize.experimental.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
